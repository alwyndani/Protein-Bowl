PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
CLIENT_URL="http://localhost:3000"


# --- Phase 4C hardening (all optional in development) ---
# Comma-separated exact browser origins allowed by CORS/origin checks.
# REQUIRED in production (no wildcard). Development falls back to CLIENT_URL.
# CORS_ALLOWED_ORIGINS="https://<your-production-web-origin>"
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see the real client IP.
# TRUST_PROXY=1
# JSON/urlencoded body size limit (binary uploads need dedicated handling later).
# JSON_BODY_LIMIT=256kb
# Rate limits: requests per window per IP (defaults shown).
# RL_LOGIN_MAX=20
# RL_LOGIN_WINDOW_MS=900000
# RL_REGISTER_MAX=10
# RL_REGISTER_WINDOW_MS=3600000
# RL_REFRESH_MAX=60
# RL_REFRESH_WINDOW_MS=900000
# RL_GENERAL_MAX=600
# RL_GENERAL_WINDOW_MS=900000
# Development only (ignored in production): disable all rate limiting.
# RL_DISABLED=false
# Development-only password for demo seed users (defaults to the documented dev password).
# Demo users are NEVER seeded when NODE_ENV=production.
# SEED_DEFAULT_PASSWORD=
