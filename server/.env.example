PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
CLIENT_URL="http://localhost:3000"


# --- Phase 4C hardening (all optional in development) ---
# Comma-separated exact browser origins allowed by CORS/origin checks.
# REQUIRED in production (no wildcard). Development falls back to CLIENT_URL.
# CORS_ALLOWED_ORIGINS="https://<your-production-web-origin>"
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see the real client IP.
# TRUST_PROXY=1
# JSON/urlencoded body size limit (binary uploads need dedicated handling later).
# JSON_BODY_LIMIT=256kb
# Rate limits: requests per window per IP (defaults shown).
# RL_LOGIN_MAX=20
# RL_LOGIN_WINDOW_MS=900000
# RL_REGISTER_MAX=10
# RL_REGISTER_WINDOW_MS=3600000
# RL_REFRESH_MAX=60
# RL_REFRESH_WINDOW_MS=900000
# RL_GENERAL_MAX=600
# RL_GENERAL_WINDOW_MS=900000
# Development only (ignored in production): disable all rate limiting.
# RL_DISABLED=false
# Development-only password for demo seed users (defaults to the documented dev password).
# Demo users are NEVER seeded when NODE_ENV=production.
# SEED_DEFAULT_PASSWORD=

# --- P6B staff onboarding / administration (all optional) ---
# Staff invitations are NOT emailed (no email provider yet). "manual" returns a one-time setup link ONCE to the authorizing
# SUPER_ADMIN, who hands it over out of band. REQUIRED in production (startup fails if missing or unsupported);
# optional in development/test (defaults to manual). Only "manual" is supported until the email adapter exists.
# INVITE_DELIVERY=manual
# Invitation lifetime in hours (default 72, max 336).
# INVITE_TTL_HOURS=72
# Web origin used to build the setup link (defaults to the first CORS allowed origin). Token travels in the URL fragment.
# STAFF_INVITE_BASE_URL=https://admin.example.com
# Lifetime of the password step-up proof in seconds (default 300, max 900).
# STEP_UP_TTL_SECONDS=300
# Rate limits for credential-sensitive endpoints (requests per window per IP).
# RL_ACCEPT_INVITE_MAX=10
# RL_ACCEPT_INVITE_WINDOW_MS=900000
# RL_STEPUP_MAX=10
# RL_STEPUP_WINDOW_MS=900000

# --- One-time SUPER_ADMIN bootstrap (CLI only: `npm run admin:bootstrap`). NEVER commit real values; unset afterwards. ---
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=   # prefer the hidden prompt or piping the password on stdin instead

# --- P7A commerce policy (server-authoritative pricing rules; NOT secrets) ---
# PRODUCT DECISIONS: Protein Bowl's real values are not decided yet. In PRODUCTION every value below MUST be set explicitly
# (startup fails otherwise - there are no production defaults). In development/test a missing value falls back to clearly
# labelled DEVELOPMENT EXAMPLE values (shown in the snapshot as policySource=DEVELOPMENT_DEFAULTS) which are NOT policy.
# Tax mode: only EXCLUSIVE (tax added on top of item prices, per-product rate) is supported; other values fail startup.
# COMMERCE_TAX_MODE=EXCLUSIVE
# Delivery fee (INR, 0 is valid) and an OPTIONAL free-delivery threshold (compared with the items subtotal).
# COMMERCE_DELIVERY_FEE=30.00
# COMMERCE_FREE_DELIVERY_ENABLED=true
# COMMERCE_FREE_DELIVERY_THRESHOLD=600.00   # required when enabled; must be unset when COMMERCE_FREE_DELIVERY_ENABLED=false
# Order-level flat packaging fee (0 is valid and means "no fee", not "missing").
# COMMERCE_PACKAGING_FEE=0.00
# Minimum order value on the items subtotal; 0 disables the rule.
# COMMERCE_MIN_ORDER_VALUE=0
# Fee taxability: only "false" is supported today (fees are not taxed).
# COMMERCE_DELIVERY_TAXABLE=false
# COMMERCE_PACKAGING_TAXABLE=false
# Quantity safety limits (configurable BELOW the technical ceilings of 1000 per line / 10000 per cart).
# COMMERCE_MAX_LINE_QUANTITY=20
# COMMERCE_MAX_CART_UNITS=50
# Cash on delivery. Even when enabled, P7A never confirms or marks a COD order paid.
# COMMERCE_COD_ENABLED=false

# --- P7B payments (Razorpay behind a PaymentProvider abstraction; INR only) ---
# PRODUCTION: PAYMENT_PROVIDER must be set explicitly to 'razorpay' (startup fails otherwise) and 'mock' is refused.
# Development/test default to the in-process mock provider. NEVER commit real keys/secrets.
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx            # public key id (also sent to the browser)
# RAZORPAY_KEY_SECRET=                              # SECRET: server only
# RAZORPAY_WEBHOOK_SECRET=                          # SECRET: configured in the Razorpay dashboard for https://<your-api>/api/v1/payments/webhook
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=                 # optional: the old secret while rotating (retried old events are signed with it)
# RAZORPAY_API_BASE=https://api.razorpay.com/v1     # override allowed outside production only (tests)
# DEPLOYMENT PREREQUISITE: the Razorpay account MUST use AUTO-CAPTURE (Dashboard > Settings > Payment Capture). The application does not
# silently assume it: a payment that stays 'authorized' is never confirmed (and Razorpay auto-refunds uncaptured payments after its window).
# Application payment-session TTL in minutes (NOT the provider order expiry).
# PAYMENT_SESSION_TTL_MINUTES=15
# An UNKNOWN provider-order creation younger than this is 'in progress'. Elapsing it NEVER proves the order unusable / never replaces it.
# PAYMENT_UNKNOWN_GRACE_SECONDS=120
# An UNKNOWN attempt older than this is flagged for operator review (still never auto-abandoned).
# PAYMENT_UNKNOWN_REVIEW_MINUTES=30
# Old/expired provider orders stay under reconciliation watch this long (late captures are still ledgered).
# PAYMENT_OLD_ORDER_WATCH_DAYS=7
# Webhook / reconciliation retries: bounded exponential backoff with jitter.
# PAYMENT_RETRY_MAX_ATTEMPTS=12
# PAYMENT_RETRY_BASE_SECONDS=30
# PAYMENT_RETRY_MAX_SECONDS=3600
# PAYMENT_PROVIDER_TIMEOUT_MS=8000
# PAYMENT_RECONCILE_LEASE_SECONDS=120
# PAYMENT_RECONCILE_BATCH_SIZE=25
# Rate limits (the webhook limit is deliberately generous: its signature is the real authentication).
# RL_PAYMENT_ATTEMPT_MAX=20
# RL_PAYMENT_ATTEMPT_WINDOW_MS=900000
# RL_PAYMENT_VERIFY_MAX=30
# RL_PAYMENT_VERIFY_WINDOW_MS=900000
# RL_WEBHOOK_MAX=3000
# RL_WEBHOOK_WINDOW_MS=900000
